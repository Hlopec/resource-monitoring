erDiagram
    tenant {
        UUID id PK
        string tenant_code
        string display_name
        timestamp created_at
        timestamp updated_at
        boolean is_active
    }

    organization {
        UUID id PK
        UUID tenant_id FK
        UUID parent_organization_id FK
        string organization_code
        string display_name
        timestamp created_at
        timestamp updated_at
        boolean is_active
    }

    resource_type {
        UUID id PK
        UUID tenant_id FK
        UUID parent_resource_type_id FK
        string type_code
        string display_name
        timestamp created_at
        timestamp updated_at
    }

    resource {
        UUID id PK
        UUID tenant_id FK
        UUID resource_type_id FK
        string canonical_name
        string display_name
        UUID lifecycle_status_id
        UUID criticality_id
        UUID exposure_level_id
        int source_priority
        decimal confidence_score
        timestamp first_seen_at
        timestamp last_seen_at
        timestamp confirmed_at
        timestamp archived_at
        timestamp created_at
        timestamp updated_at
        int record_version
    }

    identifier_type {
        UUID id PK
        UUID tenant_id FK
        string identifier_code
        string display_name
        boolean is_authoritative
    }

    resource_identifier {
        UUID id PK
        UUID tenant_id FK
        UUID resource_id FK
        UUID identifier_type_id FK
        string namespace
        string normalized_value
        string original_value
        string value_hash
        boolean is_primary
        decimal confidence_score
        timestamp valid_from
        timestamp valid_to
        timestamp created_at
    }

    ownership_role {
        UUID id PK
        UUID tenant_id FK
        string role_code
        string display_name
    }

    resource_ownership {
        UUID id PK
        UUID tenant_id FK
        UUID resource_id FK
        UUID organization_id FK
        UUID ownership_role_id FK
        boolean is_primary
        timestamp valid_from
        timestamp valid_to
        UUID source_id
        decimal confidence_score
        timestamp created_at
    }

    relationship_type {
        UUID id PK
        UUID tenant_id FK
        string relationship_code
        string display_name
    }

    resource_relationship {
        UUID id PK
        UUID tenant_id FK
        UUID source_resource_id FK
        UUID relationship_type_id FK
        UUID target_resource_id FK
        decimal confidence_score
        timestamp first_seen_at
        timestamp last_seen_at
        timestamp valid_from
        timestamp valid_to
        UUID source_id
        jsonb attributes
        timestamp created_at
    }

    classification_type {
        UUID id PK
        UUID tenant_id FK
        string classification_code
        string display_name
    }

    classification_value {
        UUID id PK
        UUID tenant_id FK
        UUID classification_type_id FK
        string value_code
        string display_name
    }

    resource_classification {
        UUID id PK
        UUID tenant_id FK
        UUID resource_id FK
        UUID classification_value_id FK
        timestamp valid_from
        timestamp valid_to
        timestamp created_at
    }

    label {
        UUID id PK
        UUID tenant_id FK
        string label_code
        string display_name
    }

    resource_label {
        UUID id PK
        UUID tenant_id FK
        UUID resource_id FK
        UUID label_id FK
        timestamp valid_from
        timestamp valid_to
        timestamp created_at
    }

    resource_state_history {
        UUID id PK
        UUID tenant_id FK
        UUID resource_id FK
        UUID lifecycle_status_id
        UUID criticality_id
        UUID exposure_level_id
        decimal confidence_score
        timestamp changed_at
        string changed_by_type
        UUID changed_by_id
        string reason_code
        UUID source_event_id
    }

    resource_merge {
        UUID id PK
        UUID tenant_id FK
        UUID source_resource_id FK
        UUID target_resource_id FK
        string merge_reason
        string merge_strategy
        UUID initiated_by
        timestamp merged_at
        jsonb metadata
    }

    domain_resource {
        UUID resource_id PK, FK
        string fqdn
        string registrable_domain
        string public_suffix
        boolean is_idn
    }

    ip_resource {
        UUID resource_id PK, FK
        inet address
        int ip_version
        boolean is_public
    }

    url_resource {
        UUID resource_id PK, FK
        string scheme
        string host
        int port
        string path
        string query_hash
        string normalized_url
    }

    network_service_resource {
        UUID resource_id PK, FK
        UUID ip_resource_id FK
        string transport_protocol
        int port
        string application_protocol
    }

    repository_resource {
        UUID resource_id PK, FK
        string provider
        string owner_path
        string repository_name
        string provider_repository_id
        string default_branch
    }

    container_image_resource {
        UUID resource_id PK, FK
        string registry
        string repository
        string digest
    }

