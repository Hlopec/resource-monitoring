erDiagram
    TENANT {
        UUID id PK
        string tenant_code
        string display_name
        timestamp created_at
        timestamp updated_at
        boolean is_active
    }

    ORGANIZATION {
        UUID id PK
        UUID tenant_id FK
        UUID parent_organization_id FK
        string organization_code
        string display_name
        timestamp created_at
        timestamp updated_at
        boolean is_active
    }

    RESOURCE_TYPE {
        UUID id PK
        UUID tenant_id FK
        UUID parent_resource_type_id FK
        string type_code
        string display_name
        timestamp created_at
        timestamp updated_at
    }

    RESOURCE {
        UUID id PK
        UUID tenant_id FK
        UUID resource_type_id FK
        UUID canonical_resource_id FK
        string resource_name
        string status
        timestamp created_at
        timestamp updated_at
        timestamp valid_from
        timestamp valid_to
    }

    IDENTIFIER_TYPE {
        UUID id PK
        UUID tenant_id FK
        string identifier_code
        string display_name
        boolean is_authoritative
    }

    RESOURCE_IDENTIFIER {
        UUID id PK
        UUID tenant_id FK
        UUID resource_id FK
        UUID identifier_type_id FK
        string normalized_value
        string raw_value
        timestamp created_at
        timestamp updated_at
        timestamp valid_from
        timestamp valid_to
    }

    OWNERSHIP_ROLE {
        UUID id PK
        UUID tenant_id FK
        string role_code
        string display_name
    }

    RESOURCE_OWNERSHIP {
        UUID id PK
        UUID tenant_id FK
        UUID resource_id FK
        UUID organization_id FK
        UUID ownership_role_id FK
        timestamp created_at
        timestamp updated_at
        timestamp valid_from
        timestamp valid_to
    }

    RELATIONSHIP_TYPE {
        UUID id PK
        UUID tenant_id FK
        string relationship_code
        string display_name
    }

    RESOURCE_RELATIONSHIP {
        UUID id PK
        UUID tenant_id FK
        UUID source_resource_id FK
        UUID target_resource_id FK
        UUID relationship_type_id FK
        timestamp created_at
        timestamp updated_at
        timestamp valid_from
        timestamp valid_to
    }

    CLASSIFICATION_TYPE {
        UUID id PK
        UUID tenant_id FK
        string classification_code
        string display_name
    }

    CLASSIFICATION_VALUE {
        UUID id PK
        UUID tenant_id FK
        UUID classification_type_id FK
        string value_code
        string display_name
    }

    RESOURCE_CLASSIFICATION {
        UUID id PK
        UUID tenant_id FK
        UUID resource_id FK
        UUID classification_value_id FK
        timestamp created_at
        timestamp updated_at
        timestamp valid_from
        timestamp valid_to
    }

    LABEL {
        UUID id PK
        UUID tenant_id FK
        string label_code
        string display_name
    }

    RESOURCE_LABEL {
        UUID id PK
        UUID tenant_id FK
        UUID resource_id FK
        UUID label_id FK
        timestamp created_at
        timestamp updated_at
        timestamp valid_from
        timestamp valid_to
    }

    RESOURCE_STATE_HISTORY {
        UUID id PK
        UUID tenant_id FK
        UUID resource_id FK
        string previous_state
        string next_state
        timestamp changed_at
        timestamp created_at
    }

    RESOURCE_MERGE {
        UUID id PK
        UUID tenant_id FK
        UUID source_resource_id FK
        UUID target_resource_id FK
        UUID reviewed_by FK
        string merge_reason
        string review_status
        timestamp merged_at
        timestamp created_at
        timestamp updated_at
    }

    RESOURCE_OBSERVATION {
        UUID id PK
        UUID tenant_id FK
        UUID resource_id FK
        timestamp observed_at
        timestamp created_at
    }

    TECHNOLOGY_DETECTION {
        UUID id PK
        UUID tenant_id FK
        UUID resource_id FK
        timestamp detected_at
        timestamp created_at
    }

    FINDING_EVENT {
        UUID id PK
        UUID tenant_id FK
        UUID resource_id FK
        timestamp occurred_at
        timestamp created_at
    }

    AUDIT_EVENT {
        UUID id PK
        UUID tenant_id FK
        UUID resource_id FK
        timestamp occurred_at
        timestamp created_at
    }

    OUTBOX_EVENT {
        UUID id PK
        UUID tenant_id FK
        UUID resource_id FK
        timestamp occurred_at
        timestamp created_at
    }

    VULNERABILITY_RECORD {
        UUID id PK
        UUID tenant_id FK
        UUID resource_id FK
        timestamp observed_at
        timestamp created_at
    }

